# Required for broad online discovery and OpenAlex full-text content.
OPENALEX_API_KEY=

# Optional polite-contact values for metadata providers.
CROSSREF_EMAIL=
UNPAYWALL_EMAIL=

# Model-assisted question interpretation, adjudication, and grounded analysis.
# Choose mistral (default), openai, or codex. There is no automatic failover.
SCI_SEARCH_ANALYSIS_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Personal local workspace only: install Codex CLI and run `codex login` with ChatGPT.
# Set both SCI_SEARCH_CODEX_ENABLED=1 and SCI_SEARCH_ANALYSIS_PROVIDER=codex to use it.
SCI_SEARCH_CODEX_ENABLED=0
SCI_SEARCH_CODEX_MODEL=gpt-6-sol
# Optional additional model IDs offered in the web UI, grouped by provider.
# Only list models supported by the provider's structured-output API and your account.
SCI_SEARCH_ANALYSIS_MODELS={}
