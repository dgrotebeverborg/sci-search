{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sci-search/researcher_gold_v1.schema.json",
  "title": "Sci-Search independent researcher gold labels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "must_retrieve_publications",
    "must_exclude_publications",
    "key_conclusions",
    "counterevidence",
    "required_distinctions",
    "answerability",
    "review_revisions"
  ],
  "properties": {
    "schema_version": {"const": "researcher_gold_v1"},
    "case_id": {"type": "string", "minLength": 1},
    "must_retrieve_publications": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "must_exclude_publications": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "key_conclusions": {"type": "object"},
    "counterevidence": {"type": "object"},
    "required_distinctions": {"type": "object"},
    "answerability": {"type": "object", "minProperties": 1},
    "review_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/review_revision"}
    }
  },
  "$defs": {
    "review_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "independent_review",
        "blinded_to_system_output",
        "reviewed_at",
        "decision"
      ],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 120},
        "independent_review": {"const": true},
        "blinded_to_system_output": {"type": "boolean"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "decision": {"type": ["string", "boolean", "object"]}
      }
    }
  }
}
